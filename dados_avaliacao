def validar_base():
    """Retorna um resumo de integridade da base."""
    componentes = METADADOS_AVALIACAO["componentes"]
    faltas = []
    total_dimensoes = 0
    total_itens = 0
    for ano in METADADOS_AVALIACAO["anos"]:
        for tri in METADADOS_AVALIACAO["trimestres"]:
            bloco = AVALIACAO_DB.get(ano, {}).get(tri, {})
            for componente in componentes:
                base = bloco.get(componente)
                if not base:
                    faltas.append((ano, tri, componente))
                    continue
                total_dimensoes += len(base.get("dimensoes", []))
                total_itens += len(base.get("itens_curriculares", []))
    return {
        "ok": not faltas,
        "faltas": faltas,
        "anos": len(METADADOS_AVALIACAO["anos"]),
        "trimestres_por_ano": len(METADADOS_AVALIACAO["trimestres"]),
        "componentes": len(componentes),
        "combinacoes_ano_trimestre_componente": 5 * 3 * 5,
        "total_dimensoes": total_dimensoes,
        "total_itens_curriculares": total_itens,
    }


if __name__ == "__main__":
    print(validar_base())
